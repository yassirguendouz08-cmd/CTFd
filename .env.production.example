# Copy to a private .env file on the platform host; never commit the real file.
# Fill these required database values in the private .env file before starting Compose.
DATABASE_URL=
MARIADB_ROOT_PASSWORD=
MARIADB_USER=ctfd
MARIADB_PASSWORD=
MARIADB_DATABASE=ctfd

PUBLIC_ORIGIN=https://ctf.cyberdune.online
TRUSTED_HOSTS=ctf.cyberdune.online
# Set only on a dedicated challenge worker deployment after DNS/firewall testing.
# Leave empty to keep new instances private on loopback.
INSTANCE_PUBLIC_HOST=
# Example bounded range outside the audited Linux ephemeral range. Re-check
# listener and Docker port usage on the VPS before enabling public challenges.
INSTANCE_PORT_MIN=20000
INSTANCE_PORT_MAX=20127
INSTANCE_PORT_STATE_FILE=/var/lib/chall-manager/cyberdune-port-allocations.json
# Optional HTTPS edge. Set INSTANCE_EDGE_HOST only after *.targets resolves and
# the host has a wildcard certificate; leave empty to keep challenges private.
# Edge mode replaces INSTANCE_PUBLIC_HOST (never set both).
INSTANCE_EDGE_HOST=
INSTANCE_EDGE_NETWORK=ctfd_instance_edge
# Compose creates and persists its signing secret automatically.
# Existing SECRET_KEY installations can keep their current value in the real .env.
SECRET_KEY=
